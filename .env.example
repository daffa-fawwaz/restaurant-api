# API
API_PORT=3001
JWT_SECRET=ganti-dengan-random-secret-yang-panjang
JWT_EXPIRES_IN=1d

# PostgreSQL (gunakan password kuat sebelum deploy ke VPS)
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=ganti-dengan-password-kuat
# POSTGRES_PORT=5432

# Supabase Storage (isi jika endpoint upload gambar digunakan)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
