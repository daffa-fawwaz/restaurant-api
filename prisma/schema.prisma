generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
}

model Table {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  capacity  Int
  orders      Order[]
  isAvailable    Boolean @default(true)
  createdAt DateTime @default(now())
}

model Menu {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  image       String?
  category    Category @default(Main)
  price       Decimal  @db.Decimal(10,2)
  isAvailable Boolean  @default(true)

  orderItems  OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            Int         @id @default(autoincrement())

  tableId       Int
  table         Table       @relation(fields: [tableId], references: [id])

  source        OrderSource @default(CUSTOMER)
  status        OrderStatus @default(IN_PROGRESS)

  subtotal      Decimal     @db.Decimal(10,2)
  serviceCharge Decimal     @db.Decimal(10,2)
  total         Decimal     @db.Decimal(10,2)

  isPaid        Boolean     @default(false)
  amountReceived Decimal?   @db.Decimal(10,2)
  changeAmount   Decimal?   @db.Decimal(10,2)
  paidAt         DateTime?

  items         OrderItem[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        Int      @id @default(autoincrement())

  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuId    Int
  menu      Menu     @relation(fields: [menuId], references: [id])

  quantity  Int
  price     Decimal  @db.Decimal(10,2)
  note      String?

  createdAt DateTime @default(now())
}

enum Category {
  Main
  Snack
  Drink
}

enum OrderStatus {
  IN_PROGRESS
  SERVED
  PAID
}

enum OrderSource {
  CUSTOMER
  ADMIN
}
